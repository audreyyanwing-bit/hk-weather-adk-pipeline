# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so your secrets are never committed.

# Gemini API key from https://aistudio.google.com (free tier is enough)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-gemini-api-key-here

# Model used by every agent (any Gemini model with a free tier works)
GEMINI_MODEL=gemini-3.5-flash-lite

# Your Google Cloud project ID (shown in the project picker in the Cloud console)
GOOGLE_CLOUD_PROJECT=your-project-id

# Your Google Cloud Storage bucket (just the name, no gs://)
GCS_BUCKET=your-bucket-name

# Folder ("prefix") inside the bucket where each run is stored
GCS_PREFIX=hk-weather
